TZ=UTC
PORT=4444
HOST=localhost
LOG_LEVEL=silent
NODE_ENV=test

# Not a secret: a fixed key so the suite is reproducible.
APP_KEY=test_app_key_for_local_and_ci_runs_32

SESSION_DRIVER=memory
LIMITER_STORE=memory
DRIVE_DISK=fs

# Point every connection at the same throwaway test database.
ADMIN_DB=postgresql://postgres:postgres@localhost:5432/boss_man_test
DEV_DB=postgresql://postgres:postgres@localhost:5432/boss_man_test
PROD_DB=postgresql://postgres:postgres@localhost:5432/boss_man_test

APP_URL=http://localhost:4444
APP_NAME=boss-man
APP_VERSION=test
APP_ENV=development

SMTP_HOST=
SMTP_PORT=
FROM_EMAIL='test@test.com'
NO_REPLY_EMAIL='noreply@test.com'

# Third-party integrations are not exercised by the suite; placeholders keep boot validation happy.
LOOPS_API_KEY=test
RAILWAY_API_KEY=test

ONESIGNAL_APP_ID=test
ONESIGNAL_API_ENDPOINT=http://localhost
ONESIGNAL_API_KEY=test
STRIPE_SECRET=sk_test_placeholder
STRIPE_TEST_KEY=sk_test_placeholder
R2_KEY=test
R2_SECRET=test
R2_BUCKET=test
R2_ENDPOINT=http://localhost
TWIST_TOKEN=test
RESEND_API_KEY=test

# Not a secret: lets the health-check test read the full report.
HEALTH_CHECK_SECRET=test_monitoring_secret

# Blank on purpose: tests must never reach a real job store. Without these, a developer
# with MONGO_URL_* in .env has the suite open a live MongoDB client, which then keeps
# the test process alive after the last test.
MONGO_URL_DEV=
MONGO_URL_PROD=
